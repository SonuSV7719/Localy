<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Main content ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B0B0F">

        <!-- Connect / setup panel -->
        <LinearLayout
            android:id="@+id/connectPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect to your Localy PC"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pick your PC (found on WiFi) and paste an API key from the PC's API Access tab."
                android:textColor="#A1A1AA"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Discovered servers"
                android:textColor="#71717A"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/serverSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/rescanButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rescan WiFi" />

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="http://192.168.1.10:11434"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="API key"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Connect" />

            <TextView
                android:id="@+id/connectError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#F87171"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Chat panel -->
        <LinearLayout
            android:id="@+id/chatPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#12121A"
                android:padding="8dp">

                <TextView
                    android:id="@+id/menuButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☰"
                    android:textColor="#E4E4E7"
                    android:textSize="22sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="12dp" />

                <Spinner
                    android:id="@+id/modelSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/changeServerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Server" />
            </LinearLayout>

            <!-- Live chat stream metrics -->
            <LinearLayout
                android:id="@+id/streamPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111827"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/streamTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E4E4E7"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/streamStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Pooled-model load progress -->
            <LinearLayout
                android:id="@+id/poolPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#161B2E"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/poolTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E4E4E7"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/poolProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/poolStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/poolLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#71717A"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messagesList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false" />

            <!-- Staged attachments -->
            <LinearLayout
                android:id="@+id/attachmentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#12121A"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/attachmentText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#C7D2FE"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/attachmentClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#A5B4FC"
                    android:textSize="14sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#12121A"
                android:padding="8dp">

                <TextView
                    android:id="@+id/attachButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📎"
                    android:textSize="20sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp" />

                <TextView
                    android:id="@+id/imageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖼"
                    android:textSize="20sp"
                    android:paddingEnd="10dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ask something…"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#71717A"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4" />

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Send" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Sessions drawer ===== -->
    <LinearLayout
        android:id="@+id/sessionDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#0E0E14"
        android:padding="14dp"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chats"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/newChatButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="+ New chat" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/tabActive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="Active" />

            <Button
                android:id="@+id/tabArchived"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="Archived" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/sessionsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No chats yet."
            android:textColor="#71717A"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
