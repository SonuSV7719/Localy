# ===========================
# Localy — Environment Variables
# ===========================
# Copy this file to .env and customize for your setup.
# All values shown are defaults — uncomment and change only what you need.

# --- Server ---
# LOCALY_HOST=127.0.0.1
# LOCALY_PORT=11434

# --- Model Storage ---
# LOCALY_MODEL_DIR=~/.localy/models
# LOCALY_DATA_DIR=~/.localy

# --- Logging ---
# LOCALY_LOG_LEVEL=INFO
# LOCALY_LOG_FORMAT=console  # "console" for dev, "json" for production

# --- Inference Defaults ---
# LOCALY_DEFAULT_CONTEXT_LENGTH=4096
# LOCALY_DEFAULT_TEMPERATURE=0.7
# LOCALY_DEFAULT_TOP_P=0.9

# --- Tuning Profile ---
# LOCALY_TUNING_PROFILE=balanced  # conservative | balanced | aggressive

# --- Security ---
# LOCALY_API_KEY=              # Leave empty to disable API key auth (default for local use)
# LOCALY_CORS_ORIGINS=http://localhost:*

# --- Telemetry (opt-in) ---
# LOCALY_TELEMETRY_ENABLED=false
# LOCALY_TELEMETRY_ENDPOINT=https://telemetry.localy.ai/v1/report

# --- Advanced (usually don't touch) ---
# LOCALY_THREAD_COUNT_OVERRIDE=   # Override auto-detected thread count
# LOCALY_BATCH_SIZE_OVERRIDE=     # Override auto-detected batch size
# LOCALY_USE_MMAP=true            # Memory-mapped model loading
